h1= @question.title
p= @question.body

- if current_user&.owns?(@question)
  = link_to 'Delete question', question_path(@question),
          method: :delete,
          data: { turbo_method: :delete, turbo_confirm: 'Are you sure' }

= render partial: 'answers/answer', collection: @answers

= render 'shared/errors', resource: @answer

= render partial: 'answers/form', locals: { question: @question, answer: @answer }
