= turbo_frame_tag question
  h4= question.title
  p= question.body

  - if author_of?(question)
    = link_to 'Show', question_path(question), data: { turbo: false }
    = link_to 'Edit', edit_question_path(question, source_view: 'index')
    = link_to 'Delete', question_path(question),
          method: :delete,
          data: { turbo_method: :delete, turbo_confirm: 'Are you sure' }

