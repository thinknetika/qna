- if @user_rewards
  = render partial: 'layouts/rewards', locals: { collection: @user_rewards }

- if current_user
  = turbo_frame_tag 'new_question'
    = render 'questions/shared/new_question'

= turbo_stream_from("questions_channel")

div id="questions" data-controller="questions"
  - @questions.each do |question|
    = render partial: 'questions/question', locals: { question: question }
