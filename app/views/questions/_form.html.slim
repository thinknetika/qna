= turbo_frame_tag question do
  .card.mb-3
    .card-body
      = form_with model: question, class: "row g-3" do |f|
        div data-question-form-target="errors"
          = render 'shared/errors', resource: question

        .col-12
          = f.label :title, class: "form-label"
          = f.text_field :title, class: "form-control"

        .col-12
          = f.label :body, class: "form-label"
          = f.text_area :body, class: "form-control", rows: 5

        .col-12
          p Links
          = f.fields_for :links do |l|
            .row
              .col-md-6
                = l.label :name, class: "form-label"
                = l.text_field :name, class: "form-control"

              .col-md-6
                = l.label :url, class: "form-label"
                = l.text_field :url, class: "form-control"

        .col-12
          div data-controller="upload"
            = f.file_field :files,
                    multiple: true,
                    direct_upload: true,
                    data: { upload_target: "input",  action: "change->upload#uploadFile" }

        .col-12
          = f.submit 'Post question', class: "btn btn-primary"
