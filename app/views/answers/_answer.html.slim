= turbo_stream_from("answers_channel")

- @question.answers.each do |answer|
  = turbo_frame_tag answer do
    .answer data-answers-target="answer"
      .row
        .col-md-10.offset-md-1
          .card.mb-3
            .card-body
              - cache(["answer", answer]) do
                p.card-text = answer.body

                .attached-files.mt-2
                  - if answer.files.attached?
                    .d-flex.flex-wrap
                      - answer.files.each do |file|
                      = render partial: 'layouts/files', locals: { file: file, source: answer }

                div
                  - answer.links&.each do |link|
                    = render partial: 'layouts/link', locals: { resource: link }

                div
                  - if current_user
                    = render partial: 'layouts/vote_buttons', locals: { votable: answer }

                div.d-flex.align-items-center
                  - if policy(answer).edit?
                    = link_to 'Edit', edit_answer_path(answer), data: { turbo_stream: true }, class: "btn btn-warning btn-sm me-2"
                  - if policy(answer).destroy?
                    = link_to 'Delete', answer_path(answer), method: :delete, data: { turbo_method: :delete, turbo_confirm: 'Are you sure' }, class: "btn btn-danger btn-sm me-2"
                  - if answer == @question.best_answer
                    span.text-success Best answer
                  - else
                    - if BestAnswerPolicy.new(pundit_user, @question).create?
                      = button_to "Mark as best", best_answers_path(answer_id: answer.id), method: :post, data: { turbo_method: :post }, class: "btn btn-success btn-sm"

              = turbo_stream_from("answer_#{answer.id}_comments_channel")

              - cache(["answer_comments", answer]) do
                div id="answer_#{answer.id}_comments"
                  - answer.comments.each do |comment|
                    = render partial: 'comments/comment', locals: { comment: comment }

                - if current_user
                  div id="answer_new_comment"
                    = render partial: 'comments/shared/new_comment', locals: { commentable: answer }
