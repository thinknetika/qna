= turbo_frame_tag answer
  .card.mb-3
    .card-body
      = form_with url: answer_form_url(answer, question), model: answer do |f|
        = render 'shared/errors', resource: answer

        .col-12
          = f.label :body, "Your Answer", class: "form-label"
          = f.text_area :body, class: "form-control", rows: 2

        .col-12
          p Links
          div data-controller="nested-form" data-nested-form-association-name-value="links"
            template data-nested-form-target="template"
              .row.nested-fields
                .col-md-6
                  = label_tag :name, "Link Name", class: "form-label"
                  = text_field_tag :name, nil, name: "answer[links_attributes][NEW_CHILD_ID][name]", class: "form-control"

                .col-md-6
                  = label_tag :url, "URL", class: "form-label"
                  = text_field_tag :url, nil, name: "answer[links_attributes][NEW_CHILD_ID][url]", class: "form-control"

                input type="hidden" value="0" name="answer[links_attributes][NEW_CHILD_ID][_destroy]"
                = link_to "Remove link", "#", {action: "nested-form#remove"}

            div data-nested-form-target="fields"
              = f.fields_for :links do |link|
                .row.nested-fields
                  .col-md-6
                    = link.label :name, class: "form-label"
                    = link.text_field :name, class: "form-control"

                  .col-md-6
                    = link.label :url, class: "form-label"
                    = link.text_field :url, class: "form-control"

                  = link.hidden_field :_destroy
                  = link_to "Remove link", "#", data: { action: "nested-form#remove" }

            button.btn.btn-secondary data-action="nested-form#add" type="button" Add link

        .col-12
          div data-controller="upload"
            = f.file_field :files,
                    multiple: true,
                    direct_upload: true,
                    data: { upload_target: "input",  action: "change->upload#uploadFile" }

        .col-12
          = f.submit "Post answer", class: "btn btn-primary"
