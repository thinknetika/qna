<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "Qna" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <%= hidden_field_tag 'user_signed_in', user_signed_in? %>
</head>

<body>
<%= render 'layouts/navbar' %>

<div class="container">
  <%= form_with url: search_path, method: :get, data: {turbo_stream: true}, html: { class: "mb-3" } do |form| %>
    <div class="input-group">
      <%= form.text_field :query, value: params[:query], class: "form-control", placeholder: "Search..." %>
      <%= form.select :category, options_for_select([["All Categories", "all"],
                                                     %w[Questions questions],
                                                     %w[Answers answers],
                                                     %w[Users users],
                                                     %w[Comments comments]],
                                                    params[:category]),
                      { include_blank: "Select Category" },
                      { class: "form-select" } %>


      <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
  <% end %>

  <p class="notice"><%= notice %></p>
  <p class="alert"><%= alert %></p>

  <turbo-frame id="search-results">
    <%# Initial content or empty state %>
  </turbo-frame>

  <%= yield %>
</div>
</body>
</html>
